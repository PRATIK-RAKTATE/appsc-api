# Server
PORT=5000

# MongoDB
MONGODB_URI=

# SMTP / Gmail
SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_USER=

SMTP_PASS=

# JWT
JWT_ACCESS_SECRET=

JWT_REFRESH_SECRET=

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=

GOOGLE_CLOUD_PROJECT_ID=

# Redis
REDIS_HOST=

REDIS_PORT=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=

#claudeflare
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_EXPIRY_SECONDS=3600

# MongoDB Backup
# 64-character hex string (32-byte key): openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
# Override path to mongodump binary (e.g. for Windows local installs)
MONGODUMP_PATH=
# Cron schedule for automated backups (default: 02:00 UTC daily)
BACKUP_CRON_SCHEDULE=0 2 * * *
# Timezone for cron schedule
BACKUP_CRON_TIMEZONE=UTC
# Temporary directory for backup files (default: tmp/mongodb-backups)
BACKUP_TEMP_DIR=
